# Copy to .env at the repo root and fill in real values. Never commit .env itself.
# Sam manages this file directly - nothing here is read or written by the assistant.

# --- Backend (Railway) ---
# Postgres connection string, provided by Railway once the Postgres service is added.
# Railway gives both an internal URL (DATABASE_URL, only resolves inside Railway's
# network) and a public proxy URL (DATABASE_PUBLIC_URL, needed for local dev and
# for running Alembic migrations from this machine). Set both once Railway exists;
# the backend prefers the public one when both are present (see app/config.py).
DATABASE_URL=
DATABASE_PUBLIC_URL=

# Comma-separated list of origins the backend's CORS policy allows. Local frontend
# dev server default is included; add the deployed CloudFront URL once it exists.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# development | production - not load-bearing yet, reserved for later use
ENVIRONMENT=development

# --- Frontend (Vite) ---
# Vite only exposes variables prefixed VITE_ to client code. Points the frontend at
# the backend API - localhost for local dev, the Railway URL once deployed.
VITE_API_BASE_URL=http://localhost:8000

# --- Data source credentials ---
# None of the three primary hazard feeds (USGS, NHC, NIFC WFIGS) require a key.
# Phase 0 verification will confirm whether GDACS, VIDA (source.coop), or NSI need
# any credential or token - entries will be added here if so, not before.
